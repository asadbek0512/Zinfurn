MONGO_URI=mongodb://localhost:27017/zinfurn
SECRET_TOKEN=your_jwt_secret_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Sign in with Apple — identity token audience (iOS bundle ID; vergul bilan bir nechta)
APPLE_CLIENT_IDS=uz.zinfurn.app
ADMIN_TELEGRAM_CHAT_ID=your_admin_telegram_chat_id
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=Zinfurn <onboarding@resend.dev>
PORT_API=3007
GEMINI_API_KEY=your_gemini_api_key

# AI so'rovlari kunlik limiti (xarajat nazorati). Berilmasa: member 10, anonim 3.
AI_DAILY_LIMIT_MEMBER=10
AI_DAILY_LIMIT_ANON=3

# Sessiya muddati (sekundlarda)
# SESSION_MAX_AGE_SEC — login paytidan boshlab MUTLAQ chegara. Refresh rotation buni uzaytirmaydi.
SESSION_MAX_AGE_SEC=36000
# App (Capacitor) sessiyasi: har refresh IDLE ga uzayadi, login+MAX_AGE dan oshmaydi
APP_SESSION_IDLE_SEC=2592000
APP_SESSION_MAX_AGE_SEC=7776000
# ACCESS_TOKEN_TTL_SEC — access token umri; sessiya qoldig'idan oshmaydi.
ACCESS_TOKEN_TTL_SEC=3600

# Mobil app (Capacitor) OAuth callback deep link
APP_DEEP_LINK=uz.zinfurn.app://auth

# Toss Payments — hujjatlardagi ochiq TEST kalit (real pul yechilmaydi)
TOSS_SECRET_KEY=test_sk_zXLkKEypNArWmo50nX3lmeaxYG5R
# USD narxni KRW ga o'tkazish kursi (Toss faqat KRW qabul qiladi)
KRW_PER_USD=1350

# AI chat personas (Groq)
GROQ_API_KEY=
GROQ_MODEL=

# Push notifications (bo'sh bo'lsa o'chiq)
# Android: Firebase service account JSON (yoki base64)
FIREBASE_SERVICE_ACCOUNT=
# iOS: APNs .p8 key (qatorlar \n bilan), Apple Developer → Keys
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY=
APNS_BUNDLE_ID=uz.zinfurn.app
APNS_SANDBOX=false

# Security alert (hujum aniqlanganda admin ogohlantirish)
ADMIN_ALERT_EMAIL=admin@example.com
# ixtiyoriy sozlashlar:
# SECURITY_ALERT_COOLDOWN_MS=300000
# AUTH_BRUTE_WINDOW_MS=60000
# AUTH_BRUTE_THRESHOLD=8
